---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout title="Contact">
  <h1>Contact</h1>

<form
  action="https://formspree.io/f/xanoeyok"
  method="POST"
  class="contact-form"
>
  <input
    type="text"
    name="name"
  
    required
  />

  <input
    type="email"
    name="email"
    
    required
  />

  <input
    type="text"
    name="subject"
 
  />

  <textarea
    name="message"
    rows="8"
     
    required
  ></textarea>

  <button type="submit">

  </button>
</form>
</PageLayout>
