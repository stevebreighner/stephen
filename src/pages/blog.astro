---

import Layout from "../layouts/Layout.astro";

const posts = Object.entries(
import.meta.glob("../content/blog/*.md", { eager: true })
).map(([path, mod]) => ({
path,
...mod,
}));

posts.sort(
(a, b) =>
new Date(b.frontmatter.date).getTime() -
new Date(a.frontmatter.date).getTime()
);
---

<Layout title="Blog">
  <div class="container">
    <div class="top">
      <h1>Blog</h1>

```
  <div class="controls">
    <input id="search" type="text" placeholder="Search posts..." />

    <button id="listView" class="view-btn" title="List view">☰</button>
    <button id="largeView" class="view-btn" title="Large view">⊞</button>
  </div>
</div>

<div id="posts" class="large-view">
  {
    posts.map((post) => {
      const slug = post.path.split("/").pop().replace(".md", "");
      const image = post.frontmatter.image;

      return (
        <a
          class="card"
          href={`/blog/${slug}/`}
          data-title={post.frontmatter.title.toLowerCase()}
        >
          {image && (
            <div class="image-wrap">
              <img
                src={image}
                alt={post.frontmatter.title}
                loading="lazy"
              />
            </div>
          )}

          <div class="card-body">
            <div class="meta">
              {post.frontmatter.date}
            </div>

            <h2>
              {post.frontmatter.video && "🎬 "}
              {post.frontmatter.title}
            </h2>

            <p>
              {post.frontmatter.description ||
                "Click to read article..."}
            </p>
          </div>
        </a>
      );
    })
  }
</div>
```

  </div>
</Layout>

<script>
  const search = document.querySelector("#search");
  const cards = document.querySelectorAll("#posts .card");

  // Search posts
  search?.addEventListener("input", () => {
    const query = search.value.toLowerCase().trim();

    cards.forEach((card) => {
      const title = card.dataset.title || "";
      const text = card.textContent?.toLowerCase() || "";

      card.style.display =
        title.includes(query) || text.includes(query) ? "" : "none";
    });
  });

  // List / large view toggle
  const postsContainer = document.querySelector("#posts");
  const listButton = document.querySelector("#listView");
  const largeButton = document.querySelector("#largeView");

  listButton?.addEventListener("click", () => {
    postsContainer?.classList.add("list-view");
    postsContainer?.classList.remove("large-view");
  });

  largeButton?.addEventListener("click", () => {
    postsContainer?.classList.add("large-view");
    postsContainer?.classList.remove("list-view");
  });
</script>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .top h1 {
    margin: 0;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  #search {
    padding: 0.65rem 0.8rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 1rem;
    width: 220px;
  }

  .view-btn {
    border: 1px solid #ccc;
    background: white;
    border-radius: 6px;
    padding: 0.55rem 0.7rem;
    font-size: 1.1rem;
    cursor: pointer;
  }

  .view-btn:hover {
    background: #f3f3f3;
  }

  #posts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: white;
    border: 1px solid #ddd;
    border-radius: 10px;
    overflow: hidden;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
  }

  .image-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #eee;
  }

  .image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 1.2rem;
  }

  .meta {
    font-size: 0.85rem;
    opacity: 0.65;
    margin-bottom: 0.5rem;
  }

  .card h2 {
    margin: 0 0 0.6rem;
    font-size: 1.35rem;
    line-height: 1.25;
  }

  .card p {
    margin: 0;
    line-height: 1.5;
    opacity: 0.8;
  }

  /* List view */
  #posts.list-view {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  #posts.list-view .card {
    display: block;
    border-width: 0 0 1px 0;
    border-radius: 0;
    box-shadow: none;
    transform: none;
  }

  #posts.list-view .image-wrap {
    display: none;
  }

  #posts.list-view .card-body {
    padding: 1rem 0;
  }

  #posts.list-view .card h2 {
    font-size: 1.15rem;
    margin-bottom: 0.3rem;
  }

  #posts.list-view .card p {
    margin: 0;
  }

  @media (max-width: 900px) {
    #posts {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .container {
      padding: 1rem;
    }

    .top {
      flex-direction: column;
      align-items: stretch;
    }

    .controls {
      width: 100%;
    }

    #search {
      flex: 1;
      width: auto;
    }

    #posts {
      grid-template-columns: 1fr;
    }
  }
</style>
