---
import Layout from "../layouts/Layout.astro";

const posts = Object.entries(
  import.meta.glob("../content/blog/*.md", { eager: true })
).map(([path, mod]) => ({
  path,
  ...mod,
}));

posts.sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
);


---

<Layout title="Blog">
  <div class="container">
    <div class="top">
      <h1>Blog</h1>

      <div class="controls">
        <input id="search" type="text" placeholder="Search posts..." />

        <button id="listView" class="view-btn">☰</button>
        <button id="largeView" class="view-btn">⊞</button>
      </div>
    </div>

    <div id="posts">
      {
        posts.map((post) => {
          const slug = post.path.split("/").pop().replace(".md", "");

          return (
            <a
              class="card"
              href={`/blog/${slug}/`}
              data-title={post.frontmatter.title.toLowerCase()}
            >
              <div class="meta">
                {post.frontmatter.date}
              </div>

              <h2>
                {post.frontmatter.video && "🎬 "}
                {post.frontmatter.title}
              </h2>

              <p>
  {post.frontmatter.description || "Click to read article..."}
</p>
            </a>
          );
        })
      }
    </div>
  </div>
</Layout>

<script>
  const search = document.querySelector("#search");
  const cards = document.querySelectorAll("#posts .card");

  // Search posts
  search?.addEventListener("input", () => {
    const query = search.value.toLowerCase().trim();

    cards.forEach((card) => {
      const title = card.dataset.title || "";
      const text = card.textContent?.toLowerCase() || "";

      card.style.display =
        title.includes(query) || text.includes(query) ? "" : "none";
    });
  });


  // List / large view toggle
  const postsContainer = document.querySelector("#posts");
  const listButton = document.querySelector("#listView");
  const largeButton = document.querySelector("#largeView");

  listButton?.addEventListener("click", () => {
    postsContainer?.classList.add("list-view");
    postsContainer?.classList.remove("large-view");
  });

  largeButton?.addEventListener("click", () => {
    postsContainer?.classList.add("large-view");
    postsContainer?.classList.remove("list-view");
  });
</script>