---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const cards = await getCollection("cards");
---

<Layout title="Cards — Cards By Margaret">

<section class="cards-page">
  <div class="intro">
    <p class="eyebrow">CARDS BY MARGARET</p>
    <h1>Cards</h1>
    <p>Choose a card to see the artwork and order.</p>
  </div>

  <div class="gallery">
    {cards.map((card) => (
      <a class="card" href={`/artwork/${card.id}/`}>
        <div class="image-wrap">
          <img src={card.data.image} alt={card.data.title} loading="lazy" />
        </div>
        <h2>{card.data.title}</h2>
        <p>${card.data.price}</p>
      </a>
    ))}
  </div>
</section>

</Layout>

<style>
.cards-page {
  max-width: 1200px;
  margin: 0 auto;
  padding: 5rem 1.5rem;
}

.intro {
  max-width: 650px;
  margin-bottom: 4rem;
}

.eyebrow {
  font-size: 11px;
  letter-spacing: .2em;
  margin-bottom: 1rem;
}

h1 {
  font-family: Georgia, serif;
  font-size: clamp(3rem, 7vw, 6rem);
  font-weight: 400;
  margin: 0 0 1rem;
}

.intro > p:last-child {
  color: #666;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
}

.card {
  color: inherit;
  text-decoration: none;
}

.image-wrap {
  background: #f5f5f3;
  overflow: hidden;
}

.image-wrap img {
  display: block;
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: contain;
  transition: transform .25s ease;
}

.card:hover img {
  transform: scale(1.03);
}

.card h2 {
  font-family: Georgia, serif;
  font-size: 1.2rem;
  font-weight: 400;
  margin: .8rem 0 .2rem;
}

.card p {
  margin: 0;
  color: #666;
  font-size: .9rem;
}

@media (max-width: 900px) {
  .gallery {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 600px) {
  .gallery {
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
}
</style>
