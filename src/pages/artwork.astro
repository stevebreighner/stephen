---
import PageLayout from "../layouts/PageLayout.astro";

const cards = [
  ["Angels", "angels.jpg"],
  ["Cats", "cats.jpg"],
  ["Cows", "cows.jpg"],
  ["Dogs", "dogs.jpg"],
  ["Fish", "fish_1.jpg"],
  ["Flowers", "flowers_1.jpg"],
  ["Flowers in a Vase", "flowers_vase_1.jpg"],
  ["Fruit", "fruitbowl_1.jpg"],
  ["Houses", "houses_1.jpg"],
  ["Irish", "irish_1.jpg"],
  ["Ladybug", "ladybug_1.jpg"],
  ["Leaves", "leaves_1.jpg"],
  ["Sailboats", "sailboats_1.jpg"],
  ["Thanks", "thanks_1.jpg"],
];
---

<PageLayout title="Cards">

<h1>Cards</h1>

<p class="intro">
  Handmade cards featuring Margaret's original artwork.
</p>

<div class="gallery">
  {cards.map(([title, image]) => (
    <a class="card" href={`/images/${image}`}>
      <img src={`/images/${image}`} alt={title} loading="lazy" />
      <h2>{title}</h2>
    </a>
  ))}
</div>

</PageLayout>

<style>
.intro {
  color: var(--muted);
  margin-bottom: 2rem;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.card {
  display: block;
  color: inherit;
  border: 0;
}

.card img {
  display: block;
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
}

.card h2 {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.25rem;
  font-weight: 400;
  margin: .7rem 0 0;
}

.card:hover img {
  opacity: .9;
}

@media (max-width: 800px) {
  .gallery {
    grid-template-columns: repeat(2, 1fr);
  }
}
</style>
