---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Stephen Breighner">
  <section class="hero">
<img
  src="/trinity.webp"
  alt="Featured artwork"
  loading="eager"
  fetchpriority="high"
/>

    <div class="overlay">
      <p class="tag">Featured Work</p>
      <p class="desc">Illustration • Painting • Books</p>

      <div class="actions">
        <a href="/artwork">View</a>
        <a href="/bio">About</a>
      </div>
    </div>
  </section>
</Layout>
<style>  .hero img{filter: saturate(1.9) contrast(1.05);}

</style>