---
import Layout from "../layouts/Layout.astro";

const featured = [
  {
    title: "Artwork",
    text: "Original paintings, pastels, and colored-pencil works.",
    href: "/artwork",
    image: "/images/cbm_about.jpg",
  },
  {
    title: "About Margaret",
    text: "Learn about Margaret McKeough Breighner and her work.",
    href: "/about",
    image: "/images/cbm_about.jpg",
  },
  {
    title: "Lessons",
    text: "Painting instruction for beginners, online or in person.",
    href: "/classes",
    image: "/images/cbm_about.jpg",
  },
];
---

<Layout>

  <section class="cbm-hero">
    <div class="hero-copy">
      <p class="eyebrow">ORIGINAL ARTWORK</p>
      <h1>Cards<br />By Margaret</h1>
      <p class="intro">
        Paintings, pastels, colored pencils, and handmade cards
        by Margaret McKeough Breighner.
      </p>

      <div class="hero-actions">
        <a class="primary" href="/artwork">View Artwork</a>
        <a href="/about">About Margaret</a>
      </div>
    </div>
  </section>

  <section class="welcome">
    <p class="eyebrow">CARDS BY MARGARET</p>
    <h2>Art made by hand.</h2>
    <p>
      Margaret began studying art in Switzerland in 1965 and continued
      her studies after returning to the United States. Her work now
      includes pastels, colored pencils, paintings, and cards based
      on her original artwork.
    </p>
  </section>

  <section class="feature-grid">
    {featured.map((item) => (
      <a class="feature" href={item.href}>
        <div class="feature-image">
          <img src={item.image} alt="" />
        </div>
        <div class="feature-copy">
          <h2>{item.title}</h2>
          <p>{item.text}</p>
          <span>Explore →</span>
        </div>
      </a>
    ))}
  </section>

</Layout>

<style>
  .cbm-hero {
    min-height: 78vh;
    display: flex;
    align-items: flex-end;
    padding: 8rem 7vw 7rem;
    background:
      linear-gradient(
        to top,
        rgba(0,0,0,.7),
        rgba(0,0,0,.18),
        rgba(0,0,0,0)
      ),
      url("/images/cbm_about.jpg") center / cover;
    color: white;
  }

  .hero-copy {
    max-width: 650px;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: .22em;
    margin: 0 0 1rem;
    font-weight: 600;
  }

  .hero-copy h1 {
    color: white;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4rem, 10vw, 8rem);
    line-height: .88;
    font-weight: 400;
    letter-spacing: -.055em;
    margin: 0;
  }

  .intro {
    max-width: 500px;
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 2rem 0;
    color: rgba(255,255,255,.9);
  }

  .hero-actions {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .hero-actions a {
    color: white;
    border-color: rgba(255,255,255,.5);
  }

  .hero-actions .primary {
    border: 1px solid white;
    padding: .75rem 1.1rem;
  }

  .welcome {
    max-width: 700px;
    margin: 0 auto;
    padding: 8rem 1.5rem;
    text-align: center;
  }

  .welcome h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 400;
    line-height: 1;
    margin: 0 0 1.5rem;
  }

  .welcome p:last-child {
    max-width: 600px;
    margin: auto;
    color: #555;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #ddd;
    border-top: 1px solid #ddd;
  }

  .feature {
    background: white;
    border: 0;
    padding: 0;
    transform: none !important;
  }

  .feature-image {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .feature-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
  }

  .feature:hover .feature-image img {
    transform: scale(1.04);
  }

  .feature-copy {
    padding: 2rem;
  }

  .feature-copy h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 2rem;
    font-weight: 400;
    margin: 0 0 .5rem;
  }

  .feature-copy p {
    font-size: .9rem;
    color: #666;
    margin: 0 0 1.25rem;
  }

  .feature-copy span {
    font-size: .75rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  @media (max-width: 700px) {
    .cbm-hero {
      min-height: 75vh;
      padding: 6rem 1.5rem 4rem;
    }

    .hero-copy h1 {
      font-size: clamp(3.8rem, 18vw, 6rem);
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }

    .welcome {
      padding: 5rem 1.5rem;
    }
  }
</style>
