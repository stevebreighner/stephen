---
const { title = "Cards By Margaret" } = Astro.props;

import "../styles/global.css";
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Cards By Margaret — artwork, cards, and paintings by Margaret McKeough Breighner." />
  <title>{title}</title>
</head>

<body>

<header class="header">
  <a class="brand" href="/">CARDS BY MARGARET</a>

  <button class="hamburger" id="menuBtn" aria-label="Open menu">☰</button>
</header>

<div class="menu" id="menu">
  <nav>
    <a href="/">Home</a>
    <a href="/artwork">Artwork</a>
    <a href="/about">About</a>
    <a href="/bio">About Margaret</a>
    <a href="/contact">Contact</a>
  </nav>
</div>

<main>
  <slot />
</main>

<footer class="footer">
  <span>© {new Date().getFullYear()} Cards By Margaret</span>
  <a href="/contact">Contact</a>
</footer>

<script>
  const btn = document.getElementById("menuBtn");
  const menu = document.getElementById("menu");

  btn?.addEventListener("click", () => {
    menu?.classList.toggle("open");
  });

  menu?.addEventListener("click", (e) => {
    if (e.target === menu) {
      menu.classList.remove("open");
    }
  });
</script>

</body>
</html>
