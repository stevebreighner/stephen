---
const { title = "Stephen Breighner" } = Astro.props;

import "../styles/global.css";
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta
    name="description"
    content="Explore paintings and illustrations by artist Stephen Breighner, including recent artwork, studio work, and selected pieces."
  />

  <style>
    #cart-indicator {
      display: none;
      position: absolute;
      top: 4px;
      right: 4px;
      width: 8px;
      height: 8px;
      background: #1976d2;
      border-radius: 50%;
      border: 2px solid white;
    }

    #cart-indicator.has-items {
      display: block;
    }
  </style>
</head>

<body>

<header class="header">
  <div class="brand">SB</div>

  <button
    class="hamburger"
    id="menuBtn"
    aria-label="Open menu"
    aria-expanded="false"
  >
    ☰
    <span id="cart-indicator" aria-hidden="true"></span>
  </button>
</header>

<div class="menu" id="menu">
  <nav class="menu-nav">
    <!-- Primary Content -->
    <div class="nav-group">
      <a href="/artwork">Artwork</a>
      <a href="/blog">Blog</a>
      <a href="/writings">Writings</a>
    </div>

    <!-- Secondary Utilities -->
    <div class="nav-group secondary">
      <a href="/cart/">Cart</a>
      <a href="/contact/">Contact</a>
    </div>

    <!-- Call to Action -->
    <div class="nav-group cta">
      <a href="/websites" class="cta-link">Buy this Site</a>
    </div>
  </nav>
</div>

<main>
  <slot />
</main>

<footer class="footer">
  <span>© 2026 <a id="sb" href="/contact">SB</a></span>
  <a href="/tos">Terms of Service</a>
</footer>

<script>
  const btn = document.getElementById("menuBtn");
  const menu = document.getElementById("menu");

  btn?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("open");
    btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
  });

  menu?.addEventListener("click", (e) => {
    if (e.target === menu) {
      menu.classList.remove("open");
      btn?.setAttribute("aria-expanded", "false");
    }
  });

  const cartIndicator =
    document.getElementById("cart-indicator");

  function updateCartIndicator() {
    if (!cartIndicator) return;

    try {
      const cart = JSON.parse(
        localStorage.getItem("stephen-cart") || "[]"
      );

      cartIndicator.classList.toggle(
        "has-items",
        cart.length > 0
      );
    } catch {
      cartIndicator.classList.remove("has-items");
    }
  }

  updateCartIndicator();

  window.addEventListener(
    "storage",
    updateCartIndicator
  );
</script>

<style>
/* Navigation Menu Clean Structure */
.menu-nav {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.nav-group {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.nav-group.secondary {
  padding-top: 1rem;
  border-top: 1px solid rgba(128, 128, 128, 0.2);
}

.nav-group.cta {
  margin-top: 0.5rem;
}

.cta-link {
  display: inline-block;
  align-self: flex-start;
  padding: 0.5rem 1rem;
  border: 1px solid currentColor;
  border-radius: 4px;
  font-size: 0.85rem;
  letter-spacing: 0.04em;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.cta-link:hover {
  opacity: 0.8;
}

/* Footer Styling */
.footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  margin-top: 5rem;
  padding: 2rem 0;
  font-size: 0.85rem;
  opacity: 0.65;
}

.footer a {
  color: inherit;
  text-decoration: none;
}

a#sb {
  text-decoration: underline;
}

.footer a:hover {
  opacity: 1;
}

@media (max-width: 700px) {
  .footer {
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
  }
}
</style>

</body>
</html>